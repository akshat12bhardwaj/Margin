# Required
MONGODB_URI=mongodb://127.0.0.1:27017/academic_marketplace
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional
PORT=5000
NODE_ENV=development
# Public site address, used in password-reset links
CLIENT_URL=http://localhost:5173
# Hops of reverse proxy in front of the app (1 behind one proxy); needed for correct rate limiting
TRUST_PROXY=0
# Login/register/reset attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT=20
# Without this, images are stored in server/uploads. Format: cloudinary://key:secret@cloud_name
CLOUDINARY_URL=
# Folder for uploaded photos when Cloudinary is not used (default: server/uploads)
# UPLOAD_DIR=
# Without this, reset links are printed to the server console (development only). Format: smtp://user:pass@host:587
SMTP_URL=
MAIL_FROM=Academic Book Marketplace <no-reply@example.com>
# Without these, the Google button is hidden. Authorized redirect URI in Google Cloud: CLIENT_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
